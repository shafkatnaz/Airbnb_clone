<link rel="stylesheet" href="/css/style.css">
<body>
  <nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
      <div class="container-fluid">
        <a class="navbar-brand" href="/listings"><i class="fa-solid fa-compass"></i></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
    
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
          <div class="navbar-nav">
          <a class="nav-link" href="/listings">Explore</a>
        </div>
          <div class="navbar-nav ms-auto">
            <form action="/listings/search" method="GET" class="d-flex" role="search">
              <input
              class="form-control ms-2 search-inp" 
              type="text"
              name="location"
              placeholder="Search by location">
              
              <button 
                class="btn search-btn ms-3" type="submit">
                <i class="fa-solid fa-magnifying-glass"></i>Search
              </button>
            </form>
          
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="" 
                role="button" data-bs-toggle="dropdown" 
                aria-expanded="false">
              </a>

              <ul class="dropdown-menu">
                <% countries.forEach(country => { %>
                  <li>
                    <a class="dropdown-item"
                      href="/listings/country/<%= encodeURIComponent(country) %>">
                      <%= country.charAt(0).toUpperCase() + country.slice(1) %>
                    </a>
                  </li>
                <% }) %>
              </ul>

            </li>
          </div>


        <div class="navbar-nav ms-auto">
            <a class="nav-link" href="/listings/new">Airbnb Your Home</a>
            <% if(!currUser) { %>
              <a class="nav-link" href="/signup"><b>SignUp</b></a>
              <a class="nav-link" href="/login"><b>LogIn</b></a>
            <% } %>
            <% if(currUser) { %>
              <a class="nav-link" href="/logout">LogOut</a>
            <% } %>
        </div>
      
      
      </div>
  </nav>
</body>

  
    
  