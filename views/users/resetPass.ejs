<% layout("/layouts/boilerplate") %>
<div class="col-6 offset-3"><h1>Reset passsword</h1></div>
<div class="row">
        <div class="col-6 offset-3">
            <form action="/resetPass/<%= token %>" method="POST" class="needs-validation" novalidate>
                
                <div class="mb-3">
                    <label for="password" class="form-label" >New Password</label>
                    <input name="password"
                    id="password"
                    type="password"
                    class="form-control"
                    required>
                </div>

                <div class="mb-3">
                    <label for="confirm-password" class="form-label" >Confirm Password</label>
                    <input name="confirm-password"
                    id="confirm-password"
                    type="confirm-password"
                    class="form-control"
                    required>
                </div>
                <button class="btn btn-success">Submit</button>
            </form>
        </div>
</div>